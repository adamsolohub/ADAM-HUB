-- 1. HOME / FARM VIEW CONFIGURATION
-- ==========================================
local function AddToggleToView(parentView, title, yPos, callback)
    local btn = Instance.new("TextButton")
    btn.Size = UDim2.new(0, 335, 0, 35)
    btn.Position = UDim2.new(0, 10, 0, yPos)
    btn.BackgroundColor3 = Color3.fromRGB(30, 20, 50)
    btn.BorderColor3 = Color3.fromRGB(100, 0, 180)
    btn.TextColor3 = Color3.fromRGB(255, 255, 255)
    btn.Text = title .. " [OFF]"
    btn.TextSize = 13
    btn.Font = Enum.Font.GothamSemibold
    btn.Parent = parentView

    local toggled = false
    btn.MouseButton1Click:Connect(function()
        toggled = not toggled
        if toggled then
            btn.BackgroundColor3 = Color3.fromRGB(100, 0, 200)
            btn.Text = title .. " [ON]"
        else
            btn.BackgroundColor3 = Color3.fromRGB(30, 20, 50)
            btn.Text = title .. " [OFF]"
        end
        if callback then callback(toggled) end
    end)
end

