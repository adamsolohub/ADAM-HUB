-- متغيرات نظام الأوتو لفل والمزرعة
local autoLevelActive = false
local QuestGiverCFrame = CFrame.new(1059.2, 16.9, 1549.5) -- إحداثيات مهمة البانديت بالعالم الأول

local function StopTracking()
    autoLevelActive = false
    Status.Text = "الحالة: تم إيقاف أوتو لفل"
end

-- أزرار صفحة المستوى
CreateButton("▶ START AUTO LEVEL & FARM", LevelPage, function()
    if autoLevelActive then
        Status.Text = "النظام يعمل بالفعل!"
        return
    end

    autoLevelActive = true
    Status.Text = "الحالة: يعمل أوتو لفل (طيران وقتل فردي)"

    task.spawn(function()
        while autoLevelActive do
            pcall(function()
                local char = Player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") then return end
                local hrp = char.HumanoidRootPart

                -- فحص واجهة المهمة
                local playerGui = Player:FindFirstChild("PlayerGui")
                local questGui = playerGui and playerGui:FindFirstChild("Quest")
                local hasQuest = false
                if questGui then
                    local container = questGui:FindFirstChild("Container")
                    if container and container.Visible == true then
                        hasQuest = true
                    end
                end

                if not hasQuest then
                    -- الذهاب لأخذ المهمة تلقائياً
                    hrp.CFrame = QuestGiverCFrame
                    task.wait(1)
                else
                    -- البحث عن البانديت وقتلهم واحد بواحد مع الطيران فوقهم
                    for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
                        if not autoLevelActive then break end
                        if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                            if enemy.Name == "Bandit" then
                                hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 4, 1)
                                
                                -- تفعيل السلاح والضرب الفوري
                                local tool = char:FindFirstChildOfClass("Tool")
                                if not tool then
                                    for _, t in pairs(Player.Backpack:GetChildren()) do
                                        if t:IsA("Tool") then
                                            char.Humanoid:EquipTool(t)
                                            break
                                        end
                                    end
                                else
                                    tool:Activate()
                                    VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                                end
                                task.wait(0.2)
                            end
                        end
                    end
                end
            end)
            task.wait()
        end
    end)
end)

CreateButton("⏹ STOP AUTO LEVEL", LevelPage, function()
