end)

-- محرك التشغيل السريع والذكي في الخلفية (بدون أخطاء أو لاغ)
RunService.Stepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        -- 1. منع التوقف والتعرض للضرب (Anti-Stun)
        if antiStunActive and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
            if char:FindFirstChild("Stun") then
                char.Stun:Destroy()
            end
        end

        -- 2. نظام تجميع الأعداء (Bring Mobs) لجمعهم بقربك
        if bringMobsActive then
            for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
                if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                    if enemy.Name == "Bandit" then
                        enemy.HumanoidRootPart.CFrame = hrp.CFrame * CFrame.new(0, 0, -2)
                        enemy.HumanoidRootPart.CanCollide = false
                    end
                end
            end
        end

        -- 3. نظام الزراعة التلقائية المطور (Auto-Farm)
        if autoFarmActive then
            for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
                if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                    if enemy.Name == "Bandit" then
                        -- الانتقال فوق العدو بمسافة آمنة تمنع ضرر الأعداء عنك
                        hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 4, 1)
                        
                        -- تجهيز السلاح والضرب التلقائي
                        if fastAttackActive then
                            local tool = char:FindFirstChildOfClass("Tool")
                            if not tool then
                                for _, t in pairs(LocalPlayer.Backpack:GetChildren()) do
                                    if t:IsA("Tool") then
                                        LocalPlayer.Character.Humanoid:EquipTool(t)
                                        break
                                    end
                                end
                            else
                                tool:Activate()
                            end
                        end
                        break
                    end
                end
            end
        end
    end)
end)

