local function CreateButton(text)
    local btn = Instance.new("TextButton")
    btn.Parent = MainFrame
    btn.BackgroundColor3 = Color3.fromRGB(25, 25, 38)
    btn.Size = UDim2.new(0.92, 0, 0, 45)
    btn.Font = Enum.Font.GothamBold
    btn.Text = text
    btn.TextColor3 = Color3.fromRGB(255, 90, 90)
    btn.TextSize = 13
    
    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 8)
    corner.Parent = btn
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = Color3.fromRGB(255, 90, 90)
    stroke.Thickness = 1
    stroke.Transparency = 0.4
    stroke.Parent = btn
    
    return btn, stroke
end

local AutoLevelBtn, BtnStroke = CreateButton("Auto Level & Quest (God Mode): OFF ❌")
local FastAttackBtn, FastStroke = CreateButton("Fast Attack & Equip Tool: OFF ❌")
local AntiStunBtn, AntiStroke = CreateButton("Anti-Stun & No Damage: OFF ❌")

local autoLevelActive = false
local fastAttackActive = false
local antiStunActive = false

