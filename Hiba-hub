local AntiStunBtn = CreateMenuButton("AntiStunBtn", "Anti-Stun / No Knockback: OFF ❌", Color3.fromRGB(255, 90, 90))

-- حالات التشغيل
local autoFarmActive = false
local bringMobsActive = false
local fastAttackActive = false
local antiStunActive = false

-- ربط الأزرار بتفعيل وتعطيل الميزات
