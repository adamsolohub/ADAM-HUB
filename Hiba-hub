-- حلقة RenderStepped للتشغيل السريع (GodMode, Fly, KillAura, Aimbot)
RunService.RenderStepped:Connect(function()
    SaferRun(function()
        local character = Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if humanoid then
            HealthLabel.Text = string.format("❤️ HEALTH: %d / %d", humanoid.Health, humanoid.MaxHealth)
            
            -- وضع عدم الموت (GodMode)
            if godModeEnabled then
                humanoid.Health = humanoid.MaxHealth
            end

            -- ضبط سرعة المشي
            humanoid.WalkSpeed = customWalkSpeed
        end

        -- نظام الطيران (Fly)
        if flyEnabled and hrp then
            local bv = hrp:FindFirstChild("AdamFlyForce")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "AdamFlyForce"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = hrp
            end
            
            local camDir = Camera.CFrame.LookVector
            bv.Velocity = camDir * customFlySpeed
        else
            if hrp then
                local bv = hrp:FindFirstChild("AdamFlyForce")
                if bv then bv:Destroy() end
            end
        end

        -- طاقة لا تفنى
        if infEnergyEnabled and character then
            local energy = character:FindFirstChild("Energy")
            if energy and energy:IsA("NumberValue") then
                energy.Value = 9999
            end
        end

        -- كشف الأماكن ESP
        if espEnabled then
            local enemiesFolder = Workspace:FindFirstChild("Enemies")
            if enemiesFolder then
                for _, enemy in pairs(enemiesFolder:GetChildren()) do
                    if not enemy:FindFirstChild("AdamCombatESP") and enemy:FindFirstChild("HumanoidRootPart") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "AdamCombatESP"
                        highlight.Adornee = enemy
                        highlight.FillColor = Purple
                        highlight.OutlineColor = White
                        highlight.Parent = enemy
                        table.insert(espHighlights, highlight)
                    end
                end
            end
        end

        -- ايم كيل (KillAura) وتوسيع الهيتبوكس واستهداف الرأس
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            local closestHead = nil
            local shortestDist = math.huge

            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                local head = enemy:FindFirstChild("Head")
                local hum = enemy:FindFirstChild("Humanoid")
                local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 then
                    if hitboxEnabled and enemyHrp then
                        enemyHrp.Size = Vector3.new(8, 8, 8)
                        enemyHrp.Transparency = 0.8
                        enemyHrp.CanCollide = false
                    end

                    -- ايم كيل التلقائي (Kill Aura)
                    if killAuraEnabled and hrp and enemyHrp then
                        local dist = (hrp.Position - enemyHrp.Position).Magnitude
                        if dist < 15 then
                            hum.Health = 0 -- القضاء الفوري على العدو القريب
                        end
                    end

                    if headAimEnabled and head and hrp then
                        local dist = (hrp.Position - head.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestHead = head
                        end
                    end
                end
            end

            if headAimEnabled and closestHead then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestHead.Position)
            end
        end
    end)
end)

