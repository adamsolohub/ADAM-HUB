    Btn.TextColor3 = White
    Btn.TextSize = 12
    Btn.Font = Enum.Font.GothamBold
    Btn.Active = true
    Btn.Selectable = true
    Btn.Parent = Scrolling
    
    local C = Instance.new("UICorner")
    C.CornerRadius = UDim.new(0, 10)
    C.Parent = Btn
    
    return Btn
end

