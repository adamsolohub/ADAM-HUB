-- الحلقة الأسطورية للتشغيل المستمر
RunService.RenderStepped:Connect(function()
    SaferRun(function()
        local character = Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        if povEnabled and FOVCircle then
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVCircle.Visible = true
        elseif FOVCircle then
            FOVCircle.Visible = false
        end

        if humanoid then
            if godModeEnabled then
                humanoid.MaxHealth = 1000
                humanoid.Health = 1000
            end
            HealthLabel.Text = string.format("❤️ HP: %d / %d", humanoid.Health, humanoid.MaxHealth)
            humanoid.WalkSpeed = customWalkSpeed
        end

        if flyEnabled and hrp then
            local bv = hrp:FindFirstChild("AdamFlyForce")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "AdamFlyForce"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = hrp
            end
            bv.Velocity = Camera.CFrame.LookVector * customFlySpeed
        else
            if hrp then
                local bv = hrp:FindFirstChild("AdamFlyForce")
                if bv then bv:Destroy() end
            end
        end

        if espEnabled then
            local enemiesFolder = Workspace:FindFirstChild("Enemies")
            if enemiesFolder then
                for _, enemy in pairs(enemiesFolder:GetChildren()) do
                    if enemy:FindFirstChild("HumanoidRootPart") and not enemy:FindFirstChild("AdamFullESP") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "AdamFullESP"
                        highlight.Adornee = enemy
                        highlight.FillColor = Purple
                        highlight.OutlineColor = White
                        highlight.Parent = enemy
                        table.insert(espObjects, highlight)

                        local head = enemy:FindFirstChild("Head") or enemy.PrimaryPart
                        if head then
                            local bgGui = Instance.new("BillboardGui")
                            bgGui.Name = "AdamNameESP"
                            bgGui.Size = UDim2.new(0, 120, 0, 50)
                            bgGui.StudsOffset = Vector3.new(0, 2.5, 0)
                            bgGui.AlwaysOnTop = true
                            bgGui.Parent = enemy

                            local txt = Instance.new("TextLabel")
                            txt.Size = UDim2.new(1, 0, 1, 0)
                            txt.BackgroundTransparency = 1
                            txt.TextColor3 = White
                            txt.TextSize = 13
                            txt.Font = Enum.Font.GothamBold
                            txt.TextStrokeTransparency = 0
                            txt.Text = enemy.Name
                            txt.Parent = bgGui
                            table.insert(espObjects, bgGui)
                        end
                    end
                end
            end
        end

        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            local closestHead = nil
            local shortestDist = math.huge

            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                local head = enemy:FindFirstChild("Head")
                local hum = enemy:FindFirstChild("Humanoid")
                local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 then
                    if hitboxEnabled and enemyHrp then
                        enemyHrp.Size = Vector3.new(12, 12, 12)
                        enemyHrp.Transparency = 0.7
                        enemyHrp.CanCollide = false
                    end

                    if killAuraEnabled and hrp and enemyHrp then
                        local dist = (hrp.Position - enemyHrp.Position).Magnitude
                        if dist < 25 then
                            hum.Health = 0
                        end
                    end

                    if headAimEnabled and head then
                        local screenPoint, onScreen = Camera:WorldToViewportPoint(head.Position)
                        if onScreen then
                            local screenCenter = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
                            local mouseDist = (Vector2.new(screenPoint.X, screenPoint.Y) - screenCenter).Magnitude
                            
                            if mouseDist <= povRadius and mouseDist < shortestDist then
                                shortestDist = mouseDist
                                closestHead = head
                            end
                        end
                    end
                end
            end

            if headAimEnabled and closestHead then
                local targetCFrame = CFrame.new(Camera.CFrame.Position, closestHead.Position)
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, 0.4)
            end
        end
    end)
end)

