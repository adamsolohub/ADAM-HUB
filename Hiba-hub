-- دالة فحص الكويست الدقيقة
local function CheckQuestStatus()
    local gui = Player:FindFirstChild("PlayerGui")
    local quest = gui and gui:FindFirstChild("Quest")
    if not quest then return false end
    local container = quest:FindFirstChild("Container")
    if container and container.Visible then return true end
    return false
end

local autoFarmActive = false
local QuestCFrame = CFrame.new(1059.2, 16.9, 1549.5)

CreateButton("▶ START SMART FARM", LevelPage, function()
    if autoFarmActive then
        Status.Text = "النظام يعمل بالفعل!"
        return
    end

    autoFarmActive = true
    Status.Text = "الحالة: الفارم الذكي يعمل 🚀"

    task.spawn(function()
        while autoFarmActive do
            SaferRun(function()
                local char = Player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then 
                    task.wait(1)
                    return 
                end
                
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid

                if humanoid.Health <= 0 then
                    task.wait(2)
                    return
                end

                local hasActiveQuest = CheckQuestStatus()

                if not hasActiveQuest then
                    Status.Text = "الحالة: جاري أخذ المهمة..."
                    hrp.CFrame = QuestCFrame
                    task.wait(1.2)
                else
                    Status.Text = "الحالة: جاري قتل الأعداء..."
                    local enemiesFolder = Workspace:FindFirstChild("Enemies")
                    if enemiesFolder then
                        for _, enemy in pairs(enemiesFolder:GetChildren()) do
                            if not autoFarmActive then break end
                            if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                                if enemy.Name == "Bandit" then
                                    hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 4, 2)
                                    
                                    local tool = char:FindFirstChildOfClass("Tool")
                                    if not tool then
                                        for _, t in pairs(Player.Backpack:GetChildren()) do
                                            if t:IsA("Tool") then
                                                humanoid:EquipTool(t)
                                                break
                                            end
                                        end
                                    else
                                        tool:Activate()
                                        VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                                    end
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait()
        end
    end)
end)

