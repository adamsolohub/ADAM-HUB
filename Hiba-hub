-- الحلقة التلقائية للتشغيل (POV, HeadAim, Hitbox, 1000 HP, Fly)
RunService.RenderStepped:Connect(function()
    SaferRun(function()
        local character = Player.Character
        local humanoid = character and character:FindFirstChildOfClass("Humanoid")
        local hrp = character and character:FindFirstChild("HumanoidRootPart")

        -- تحديث مكان دائرة الـ POV وسط الشاشة
        if povEnabled then
            FOVCircle.Position = Vector2.new(Camera.ViewportSize.X / 2, Camera.ViewportSize.Y / 2)
            FOVCircle.Visible = true
        else
            FOVCircle.Visible = false
        end

        if humanoid then
            -- رفع الهيلث والدم إلى 1000
            if godModeEnabled then
                humanoid.MaxHealth = 1000
                humanoid.Health = 1000
            end
            HealthLabel.Text = string.format("❤️ HP: %d / %d", humanoid.Health, humanoid.MaxHealth)
            humanoid.WalkSpeed = customWalkSpeed
        end

        -- نظام الطيران
        if flyEnabled and hrp then
            local bv = hrp:FindFirstChild("AdamFlyForce")
            if not bv then
                bv = Instance.new("BodyVelocity")
                bv.Name = "AdamFlyForce"
                bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
                bv.Velocity = Vector3.new(0, 0, 0)
                bv.Parent = hrp
            end
            bv.Velocity = Camera.CFrame.LookVector * customFlySpeed
        else
            if hrp then
                local bv = hrp:FindFirstChild("AdamFlyForce")
                if bv then bv:Destroy() end
            end
        end

        -- كشف الأماكن ESP
        if espEnabled then
            local enemiesFolder = Workspace:FindFirstChild("Enemies")
            if enemiesFolder then
                for _, enemy in pairs(enemiesFolder:GetChildren()) do
                    if not enemy:FindFirstChild("AdamCombatESP") and enemy:FindFirstChild("HumanoidRootPart") then
                        local highlight = Instance.new("Highlight")
                        highlight.Name = "AdamCombatESP"
                        highlight.Adornee = enemy
                        highlight.FillColor = Purple
                        highlight.OutlineColor = White
                        highlight.Parent = enemy
                        table.insert(espHighlights, highlight)
                    end
                end
            end
        end

        -- معالجة الهيتبوكس واستهداف الرأس داخل النطاق والمربع
        local enemiesFolder = Workspace:FindFirstChild("Enemies")
        if enemiesFolder then
            local closestHead = nil
            local shortestDist = math.huge

            for _, enemy in pairs(enemiesFolder:GetChildren()) do
                local head = enemy:FindFirstChild("Head")
                local hum = enemy:FindFirstChild("Humanoid")
                local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")

                if hum and hum.Health > 0 then
                    -- توسيع الهيتبوكس واحتساب الدمج في المربع المحيط بالعدو
                    if hitboxEnabled and enemyHrp then
                        enemyHrp.Size = Vector3.new(9, 9, 9)
                        enemyHrp.Transparency = 0.8
                        enemyHrp.CanCollide = false
                    end

                    if killAuraEnabled and hrp and enemyHrp then
                        local dist = (hrp.Position - enemyHrp.Position).Magnitude
                        if dist < 18 then
                            hum.Health = 0
                        end
                    end

                    if headAimEnabled and head and hrp then
                        local dist = (hrp.Position - head.Position).Magnitude
                        if dist < shortestDist then
                            shortestDist = dist
                            closestHead = head
                        end
                    end
                end
            end

            if headAimEnabled and closestHead then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, closestHead.Position)
            end
        end
    end)
end)

