-- نظام تتبع المستوى
local Running = false
local LevelConnection = nil

local function StopTracking()
    Running = false

    if LevelConnection then
        LevelConnection:Disconnect()
        LevelConnection = nil
    end

    Status.Text = "الحالة: تم إيقاف التتبع"
end

-- START
CreateButton("▶ START AUTO LEVEL", LevelPage, function()

    if Running then
        Status.Text = "النظام يعمل بالفعل"
        return
    end

    local Stats = Player:FindFirstChild("leaderstats")
    local Level = Stats and Stats:FindFirstChild("Level")

    if not Level then
        Status.Text = "المستوى غير متاح"
        return
    end

    Running = true

    Status.Text = "المستوى الحالي: " .. tostring(Level.Value)

    if Level.Value >= 2800 then
        StopTracking()
        Status.Text = "وصلت إلى المستوى 2800!"
        return
    end

    LevelConnection = Level:GetPropertyChangedSignal("Value"):Connect(function()

        Status.Text = "المستوى الحالي: " .. tostring(Level.Value)

        if Level.Value >= 2800 then
            StopTracking()
            Status.Text = "وصلت إلى المستوى 2800!"
        end

    end)

end)

-- STOP
CreateButton("⏹ STOP AUTO LEVEL", LevelPage, function()
    StopTracking()
end)

