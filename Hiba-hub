local function CreateBtn(Name, YPos, DefaultText)
    local Btn = Instance.new("TextButton")
    Btn.Name = Name
    Btn.Position = UDim2.fromOffset(0, YPos)
    Btn.Size = UDim2.new(1, 0, 0, 42)
    Btn.BackgroundColor3 = Light
