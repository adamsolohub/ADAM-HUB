-- نظام تحديد الإحداثيات والمهام حسب المستوى تلقائياً
local function GetDynamicQuestData(level)
    if level < 10 then
        return CFrame.new(1059.2, 16.9, 1549.5), "Bandit"
    elseif level < 15 then
        return CFrame.new(-1598.1, 35.7, 153.7), "Monkey"
    elseif level < 30 then
        return CFrame.new(-1145.9, 14.7, 3825.2), "Gorilla"
    else
        return CFrame.new(1059.2, 16.9, 1549.5), "Bandit"
    end
end

local autoFarmActive = false

CreateButton("▶ START DYNAMIC AUTO FARM", LevelPage, function()
    if autoFarmActive then
        Status.Text = "النظام يعمل بالفعل!"
        return
    end

    autoFarmActive = true
    Status.Text = "الحالة: يعمل الأوتو لفل الذكي 🚀"

    task.spawn(function()
        while autoFarmActive do
            pcall(function()
                local char = Player.Character
                if not char or not char:FindFirstChild("HumanoidRootPart") or not char:FindFirstChild("Humanoid") then 
                    task.wait(1)
                    return 
                end
                
                local hrp = char.HumanoidRootPart
                local humanoid = char.Humanoid

                if humanoid.Health <= 0 then
                    task.wait(2)
                    return
                end

                -- تحديد المستوى وجلب المهمة والعدو المناسب تلقائياً
                local stats = Player:FindFirstChild("leaderstats")
                local lvlStat = stats and stats:FindFirstChild("Level")
                local currentLevel = lvlStat and lvlStat.Value or 1

                Status.Text = "الفل الحالي: " .. tostring(currentLevel)
                local questPos, targetEnemyName = GetDynamicQuestData(currentLevel)

                -- التحقق من واجهة الكويست
                local playerGui = Player:FindFirstChild("PlayerGui")
                local questGui = playerGui and playerGui:FindFirstChild("Quest")
                local hasQuest = false
                if questGui then
                    local container = questGui:FindFirstChild("Container")
                    if container and container.Visible == true then
                        hasQuest = true
                    end
                end

                if not hasQuest then
                    hrp.CFrame = questPos
                    task.wait(1.2)
                else
                    local enemiesFolder = Workspace:FindFirstChild("Enemies")
                    if enemiesFolder then
                        for _, enemy in pairs(enemiesFolder:GetChildren()) do
                            if not autoFarmActive then break end
                            if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                                if enemy.Name == targetEnemyName then
                                    hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 4, 1)
                                    
                                    local tool = char:FindFirstChildOfClass("Tool")
                                    if not tool then
                                        for _, t in pairs(Player.Backpack:GetChildren()) do
                                            if t:IsA("Tool") then
                                                humanoid:EquipTool(t)
                                                break
                                            end
                                        end
                                    else
                                        tool:Activate()
                                        VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                                    end
                                    task.wait(0.2)
                                end
                            end
                        end
                    end
                end
            end)
            task.wait()
        end
    end)
end)

