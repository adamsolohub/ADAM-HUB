-- المحرك الرئيسي الخارق (Flying Farm & Auto Quest & Kill 1 by 1)
RunService.Stepped:Connect(function()
    pcall(function()
        local char = LocalPlayer.Character
        if not char or not char:FindFirstChild("HumanoidRootPart") then return end
        local hrp = char.HumanoidRootPart

        -- حماية ضد التوقف والـ Stun
        if antiStunActive and char:FindFirstChild("Humanoid") then
            char.Humanoid.PlatformStand = false
            if char:FindFirstChild("Stun") then
                char.Stun:Destroy()
            end
        end

        if autoLevelActive then
            local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
            local questGui = playerGui and playerGui:FindFirstChild("Quest")
            local hasQuest = false
            if questGui then
                local container = questGui:FindFirstChild("Container")
                if container and container.Visible == true then
                    hasQuest = true
                end
            end

            if not hasQuest then
                hrp.CFrame = CFrame.new(1059.2, 16.9, 1549.5)
                task.wait(0.6)
            else
                for _, enemy in pairs(Workspace.Enemies:GetChildren()) do
                    if enemy:FindFirstChild("HumanoidRootPart") and enemy:FindFirstChild("Humanoid") and enemy.Humanoid.Health > 0 then
                        if enemy.Name == "Bandit" then
                            hrp.CFrame = enemy.HumanoidRootPart.CFrame * CFrame.new(0, 4, 1)
                            
                            if fastAttackActive then
                                local tool = char:FindFirstChildOfClass("Tool")
                                if not tool then
                                    for _, t in pairs(LocalPlayer.Backpack:GetChildren()) do
                                        if t:IsA("Tool") then
                                            LocalPlayer.Character.Humanoid:EquipTool(t)
                                            break
                                        end
                                    end
                                else
                                    tool:Activate()
                                    VirtualUser:Button1Down(Vector2.new(0,0), Workspace.CurrentCamera.CFrame)
                                end
                            end
                            break
                        end
                    end
                end
            end
        end
    end)
end)

