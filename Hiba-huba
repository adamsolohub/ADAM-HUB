-- 2. زر ايم بوت الرأس
local AimBtn = CreateButton("🎯 ايم بوت الرأس القاتل (100% هيد): OFF")
AimBtn.MouseButton1Click:Connect(function()
    Settings.AimbotEnabled = not Settings.AimbotEnabled
    AimBtn.Text = Settings.AimbotEnabled and "🎯 ايم بوت الرأس القاتل (100% هيد): ON" or "🎯 ايم بوت الرأس القاتل (100% هيد): OFF"
    AimBtn.BackgroundColor3 = Settings.AimbotEnabled and Color3.fromRGB(39, 174, 96) or Color3.fromRGB(30, 30, 45)
end)

RunService.RenderStepped:Connect(function()
    if Settings.AimbotEnabled then
        pcall(function()
            local target = nil
            local minDist = math.huge
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                    if onScreen then
                        local mouse = LocalPlayer:GetMouse()
                        local dist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                        if dist < minDist then
                            minDist = dist
                            target = p.Character.Head
                        end
                    end
                end
            end
            if target then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            end
        end)
    end
end)

