-- 2. زر ايم بوت الرأس (100% هيدشوت)
local AimBtn = Instance.new("TextButton")
AimBtn.Parent = Container
AimBtn.BackgroundColor3 = Color3.fromRGB(45, 45, 65)
AimBtn.Size = UDim2.new(1, 0, 0, 42)
AimBtn.Font = Enum.Font.GothamBold
AimBtn.Text = "🎯 ايم بوت الرأس (100% هيد): OFF"
AimBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
AimBtn.TextSize = 12
local ACorn = Instance.new("UICorner")
ACorn.CornerRadius = UDim.new(0, 8)
ACorn.Parent = AimBtn

AimBtn.MouseButton1Click:Connect(function()
    Settings.AimbotEnabled = not Settings.AimbotEnabled
    AimBtn.Text = Settings.AimbotEnabled and "🎯 ايم بوت الرأس (100% هيد): ON" or "🎯 ايم بوت الرأس (100% هيد): OFF"
    AimBtn.BackgroundColor3 = Settings.AimbotEnabled and Color3.fromRGB(39, 174, 96) or Color3.fromRGB(45, 45, 65)
end)

RunService.RenderStepped:Connect(function()
    if Settings.AimbotEnabled then
        pcall(function()
            local target = nil
            local minDist = math.huge
            for _, p in pairs(Players:GetPlayers()) do
                if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("Head") and p.Character:FindFirstChild("Humanoid") and p.Character.Humanoid.Health > 0 then
                    local pos, onScreen = Camera:WorldToViewportPoint(p.Character.Head.Position)
                    if onScreen then
                        local mouse = LocalPlayer:GetMouse()
                        local dist = (Vector2.new(mouse.X, mouse.Y) - Vector2.new(pos.X, pos.Y)).Magnitude
                        if dist < minDist then
                            minDist = dist
                            target = p.Character.Head
                        end
                    end
                end
            end
            if target then
                Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
            end
        end)
    end
end)

