	InfoBox.TextYAlignment = Enum.TextYAlignment.Top
	InfoBox.Text = " جاري جلب المعلومات..."

	-- جدول لتثبيت مواقع اللاعبين عند التدوير
	local lockedPositions = {}

	-- متغيرات الميزات
	local SpinPlayersEnabled = false
	local AttackerDiesOnHit = false
	local HitboxEnabled = false
	local HitboxSize = 18
	local ESPEnabled = false
	local AutoClickerEnabled = false
	local FakePCEnabled = false
	local pcBillboard = nil
	local highlights = {}
	local distanceBillboards = {}

	local function updateColors()
		ToggleBtn.BackgroundColor3 = currentColor
		Title.TextColor3 = currentColor
		BoxFrame.BackgroundColor3 = currentColor
		for _, hl in pairs(highlights) do
			hl.FillColor = currentColor
		end
	end

	local function updateESP()
		for _, player in pairs(Players:GetPlayers()) do
			if player ~= LocalPlayer then
				if ESPEnabled and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
					if not highlights[player] then
						local hl = Instance.new("Highlight")
						hl.Name = "AdamESP"
						hl.Adornee = player.Character
						hl.FillColor = currentColor
						hl.OutlineColor = Color3.fromRGB(255, 255, 255)
						hl.FillTransparency = 0.5
						hl.OutlineTransparency = 0
						hl.Parent = player.Character
						highlights[player] = hl
					else
						highlights[player].Adornee = player.Character
						highlights[player].FillColor = currentColor
						highlights[player].Enabled = true
					end

					local head = player.Character:FindFirstChild("Head")
					if head then
						local billboard = distanceBillboards[player]
						if not billboard then
							billboard = Instance.new("BillboardGui")
							billboard.Name = "AdamDistance"
							billboard.Size = UDim2.new(0, 100, 0, 40)
							billboard.StudsOffset = Vector3.new(0, 2.5, 0)
							billboard.AlwaysOnTop = true
							
							local textLabel = Instance.new("TextLabel")
							textLabel.Name = "DistText"
							textLabel.Parent = billboard
							textLabel.Size = UDim2.new(1, 0, 1, 0)
							textLabel.BackgroundTransparency = 1
							textLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
							textLabel.TextStrokeTransparency = 0
							textLabel.Font = Enum.Font.SourceSansBold
							textLabel.TextSize = 14
							
							billboard.Adornee = head
							billboard.Parent = player.Character
							distanceBillboards[player] = billboard
						else
							local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
							if myRoot then
								local dist = math.floor((myRoot.Position - player.Character.HumanoidRootPart.Position).Magnitude)
								local txt = billboard:FindFirstChild("DistText")
								if txt then
									txt.Text = player.Name .. "\n[" .. dist .. "m]"
								end
							end
						end
					end
				else
					if highlights[player] then
						highlights[player]:Destroy()
						highlights[player] = nil
					end
					if distanceBillboards[player] then
						distanceBillboards[player]:Destroy()
						distanceBillboards[player] = nil
					end
				end
			end
		end
	end

	local function createButton(name, posY, callback)
		local btn = Instance.new("TextButton")
		btn.Parent = MainFrame
		btn.Position = UDim2.new(0, 10, 0, posY)
		btn.Size = UDim2.new(0, 230, 0, 28)
		btn.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		btn.Font = Enum.Font.SourceSans
		btn.TextSize = 14
		btn.Text = name
		
		btn.MouseButton1Click:Connect(function()
			callback(btn)
		end)
	end

	-- أزرار القائمة
	createButton("Spin Players Nearby: OFF", 35, function(btn)
		SpinPlayersEnabled = not SpinPlayersEnabled
		btn.Text = "Spin Players Nearby: " .. (SpinPlayersEnabled and "ON" or "OFF")
		if not SpinPlayersEnabled then
			lockedPositions = {}
		end
	end)

	createButton("Attacker Dies On Hit: OFF", 68, function(btn)
		AttackerDiesOnHit = not AttackerDiesOnHit
		btn.Text = "Attacker Dies On Hit: " .. (AttackerDiesOnHit and "ON" or "OFF")
	end)

	createButton("Colored Hitbox (Size 18): OFF", 101, function(btn)
		HitboxEnabled = not HitboxEnabled
		btn.Text = "Colored Hitbox (Size 18): " .. (HitboxEnabled and "ON" or "OFF")
	end)

	createButton("Wallhack & Distance ESP: OFF", 134, function(btn)
		ESPEnabled = not ESPEnabled
		btn.Text = "Wallhack & Distance ESP: " .. (ESPEnabled and "ON" or "OFF")
		if not ESPEnabled then
			for _, player in pairs(Players:GetPlayers()) do
				if highlights[player] then
					highlights[player]:Destroy()
					highlights[player] = nil
				end
				if distanceBillboards[player] then
					distanceBillboards[player]:Destroy()
					distanceBillboards[player] = nil
				end
			end
		end
	end)

	createButton("Auto Clicker: OFF", 167, function(btn)
		AutoClickerEnabled = not AutoClickerEnabled
		btn.Text = "Auto Clicker: " .. (AutoClickerEnabled and "ON" or "OFF")
	end)

	createButton("Fake PC Device Tag: OFF", 200, function(btn)
		FakePCEnabled = not FakePCEnabled
		btn.Text = "Fake PC Device Tag: " .. (FakePCEnabled and "ON" or "OFF")
		
		if FakePCEnabled then
			local char = LocalPlayer.Character
			if char and char:FindFirstChild("Head") then
				pcBillboard = Instance.new("BillboardGui")
				pcBillboard.Name = "FakePC_Tag"
				pcBillboard.Size = UDim2.new(0, 120, 0, 30)
				pcBillboard.StudsOffset = Vector3.new(0, 3.8, 0)
				pcBillboard.AlwaysOnTop = true
				
				local txt = Instance.new("TextLabel")
				txt.Parent = pcBillboard
				txt.Size = UDim2.new(1, 0, 1, 0)
				txt.BackgroundTransparency = 1
				txt.Text = "💻 [PC Player]"
				txt.TextColor3 = Color3.fromRGB(0, 255, 128)
				txt.TextStrokeTransparency = 0
				txt.Font = Enum.Font.SourceSansBold
				txt.TextSize = 16
				
				pcBillboard.Adornee = char.Head
				pcBillboard.Parent = char
			end
		else
			if pcBillboard then
				pcBillboard:Destroy()
				pcBillboard = nil
			end
		end
	end)

	local colorList = {"Green", "Red", "Blue", "Yellow", "Pink", "White"}
	local colorIndex = 1
	createButton("Theme Color: Green", 233, function(btn)
		colorIndex = colorIndex + 1
		if colorIndex > #colorList then colorIndex = 1 end
		local colorName = colorList[colorIndex]
		currentColor = Colors[colorName]
		
		btn.Text = "Theme Color: " .. colorName
		updateColors()
	end)

	Players.PlayerRemoving:Connect(function(player)
		if highlights[player] then
			highlights[player]:Destroy()
			highlights[player] = nil
		end
		if distanceBillboards[player] then
			distanceBillboards[player]:Destroy()
			distanceBillboards[player] = nil
		end
		lockedPositions[player] = nil
	end)

	LocalPlayer.CharacterAdded:Connect(function(newChar)
		if FakePCEnabled then
			task.wait(1)
			if newChar:FindFirstChild("Head") then
				if pcBillboard then pcBillboard:Destroy() end
				pcBillboard = Instance.new("BillboardGui")
				pcBillboard.Name = "FakePC_Tag"
				pcBillboard.Size = UDim2.new(0, 120, 0, 30)
				pcBillboard.StudsOffset = Vector3.new(0, 3.8, 0)
				pcBillboard.AlwaysOnTop = true
				
				local txt = Instance.new("TextLabel")
				txt.Parent = pcBillboard
				txt.Size = UDim2.new(1, 0, 1, 0)
				txt.BackgroundTransparency = 1
				txt.Text = "💻 [PC Player]"
				txt.TextColor3 = Color3.fromRGB(0, 255, 128)
				txt.TextStrokeTransparency = 0
				txt.Font = Enum.Font.SourceSansBold
				txt.TextSize = 16
				
				pcBillboard.Adornee = newChar.Head
				pcBillboard.Parent = newChar
			end
		end
	end)

	-- نظام "اللي ضربني يموت"
	local lastHealth = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") and LocalPlayer.Character.Humanoid.Health or 100
	LocalPlayer.CharacterAdded:Connect(function(newChar)
		local hum = newChar:WaitForChild("Humanoid")
		lastHealth = hum.Health
		hum.HealthChanged:Connect(function(newH)
			if AttackerDiesOnHit and newH < lastHealth then
				pcall(function()
					local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if myRoot then
						for _, p in pairs(Players:GetPlayers()) do
							if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
								local pRoot = p.Character.HumanoidRootPart
								if (myRoot.Position - pRoot.Position).Magnitude < 25 then
									local pHum = p.Character:FindFirstChild("Humanoid")
									if pHum then
										pHum.Health = 0
									end
								end
							end
						end
					end
				end)
			end
			lastHealth = newH
		end)
	end)

	if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
		LocalPlayer.Character.Humanoid.HealthChanged:Connect(function(newH)
			if AttackerDiesOnHit and newH < lastHealth then
				pcall(function()
					local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
					if myRoot then
						for _, p in pairs(Players:GetPlayers()) do
							if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
								local pRoot = p.Character.HumanoidRootPart
								if (myRoot.Position - pRoot.Position).Magnitude < 25 then
									local pHum = p.Character:FindFirstChild("Humanoid")
									if pHum then
										pHum.Health = 0
									end
								end
							end
						end
					end
				end)
			end
			lastHealth = newH
		end)
	end

	-- تحديث الـ FPS والبينغ وقوة الإشارة الحية
	task.spawn(function()
		while task.wait(1) do
			pcall(function()
				local fps = math.floor(1 / RunService.RenderStepped:Wait())
				local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
				local networkQuality = ping < 100 and "ممتازة 🟢" or (ping < 250 and "متوسطة 🟡" or "ضعيفة 🔴")

				InfoBox.Text = "👤 الحساب: " .. LocalPlayer.Name .. 
							   "\n⚡ الـ FPS: " .. fps .. " | البينغ: " .. ping .. "ms" ..
							   "\n📶 جودة الاتصال: " .. networkQuality
			end)
		end
	end)

	-- محرك التفعيل المستمر
	RunService.RenderStepped:Connect(function()
		if ESPEnabled then updateESP() end

		-- تدوير اللاعبين القريبين في مكانهم بدون أن يتحركوا من موقعهم
		if SpinPlayersEnabled then
			pcall(function()
				local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
				if myRoot then
					for _, player in pairs(Players:GetPlayers()) do
						if player ~= LocalPlayer and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
							local pRoot = player.Character.HumanoidRootPart
							local dist = (myRoot.Position - pRoot.Position).Magnitude
							if dist <= 100 then
								if not lockedPositions[player] then
									lockedPositions[player] = pRoot.Position
								end
								-- الحفاظ على نفس الموقع تماماً وتدوير الاتجاه فقط
								pRoot.CFrame = CFrame.new(lockedPositions[player]) * (pRoot.CFrame - pRoot.Position) * CFrame.Angles(0, math.rad(25), 0)
								pRoot.Velocity = Vector3.new(0, 0, 0)
								pRoot.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
							else
								lockedPositions[player] = nil
							end
						end
					end
				end
			end)
		end

		if HitboxEnabled then
			for _, player in pairs(Players:GetPlayers()) do
				if player ~= LocalPlayer and player.Character then
					local rootPart = player.Character:FindFirstChild("HumanoidRootPart")
					if rootPart then
						rootPart.Size = Vector3.new(HitboxSize, HitboxSize, HitboxSize)
						rootPart.Color = currentColor
						rootPart.Material = Enum.Material.Neon
						rootPart.Transparency = 0.5
						rootPart.CanCollide = false
					end
				end
			end
		end

		if AutoClickerEnabled then
			pcall(function() mouse1click() end)
			task.wait(0.05)
		end
	end)

	print("Adam Hub Pro Loaded Successfully!")
end

button.MouseButton1Click:Connect(function()
	local key = string.upper((input.Text or ""):gsub("%s+", ""))
	local duration = KEY_DURATIONS[key]

	if not duration then
		showError("خطأ: المفتاح غير صالح!")
		return
	end

	if duration > 0 then
		local storageName = "LINBO_ADAM_EXP_" .. key
		local ok, savedExpiry = pcall(function()
			if readfile and isfile and isfile(storageName) then
				return tonumber(readfile(storageName))
			end
			return nil
		end)

		local expiry
		if ok and savedExpiry then
			expiry = savedExpiry
		else
			expiry = os.time() + duration
			pcall(function()
				if writefile then writefile(storageName, tostring(expiry)) end
			end)
		end

		if os.time() >= expiry then
			showError("خطأ: انتهت صلاحية هذا المفتاح!")
			return
		end
	end

	status.Text = "تم التحقق بنجاح! جاري فتح القائمة..."
	status.TextColor3 = Color3.fromRGB(90, 230, 160)
	button.Text = "تم بنجاح"
	
	task.wait(0.8)
	loadAdamHub()
end)
