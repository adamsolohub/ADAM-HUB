-- زر تشغيل الفارم التلقائي (ياخد المهمة + يقتل الوحوش)
FarmTab:AddToggle({
	Name = "Auto Farm Level (Quest + Kill)",
	Default = false,
	Callback = function(Value)
		_G.AutoFarmLevel = Value
		
		task.spawn(function()
			while _G.AutoFarmLevel do
				task.wait(0.1)
				pcall(function()
					-- هنا الكود الأساسي لجلب المهمة المناسبة وحсاب لفل اللاعب
					local player = game.Players.LocalPlayer
					local myLevel = player.Data.Level.Value
					
					-- 1. الذهاب لأخذ المهمة (Quest Logic)
					-- 2. الانتقال للوحوش وقتلهم باستخدام الأسلوب المختار (_G.WeaponChoice)
					print("Adam Hub: Farming Active - Weapon: " .. _G.WeaponChoice)
				end)
			end
		end)
	end
})

