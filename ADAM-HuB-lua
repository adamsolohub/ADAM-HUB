-- الأنظمة الخلفية والتشغيل السريع
RunService.Stepped:Connect(function()
    pcall(function()
        if Settings.AutoChest then
            for _, v in pairs(Workspace:GetChildren()) do
                if v.Name:find("Chest") and v:FindFirstChild("Handle") and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
                    LocalPlayer.Character.HumanoidRootPart.CFrame = v.Handle.CFrame
                end
            end
        end
        if Settings.FastAttack then
            pcall(function()
                local vim = game:GetService("VirtualInputManager")
                vim:SendMouseButtonEvent(0, 0, 0, true, game, 0)
                vim:SendMouseButtonEvent(0, 0, 0, false, game, 0)
            end)
        end
    end)
end)

