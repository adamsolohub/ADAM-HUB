	Name = "Farming Level",
	Icon = "rbxassetid://4483345998",
	PremiumOnly = false
})

local Section = FarmTab:AddSection({
	Name = "Auto Farm Level Systems"
})

-- متغيرات التحكم
_G.AutoFarmLevel = false
_G.WeaponChoice = "Sword" -- الخيارات: Melee, Sword, Fruit

-- خيار اختيار سلاح القتال
FarmTab:AddDropdown({
	Name = "Select Weapon Style",
	Options = {"Melee", "Sword", "Fruit"},
	Default = "Sword",
